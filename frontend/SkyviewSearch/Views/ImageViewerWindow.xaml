<Window x:Class="SkyviewSearch.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Viewer"
        Height="600"
        Width="800"
        MinHeight="400"
        MinWidth="500"
        Background="#1E293B"
        WindowStartupLocation="CenterOwner">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Image -->
        <Image x:Name="ImageDisplay" 
               Grid.Row="0"
               Stretch="Uniform"
               Margin="20"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        
        <!-- Info Bar -->
        <Border Grid.Row="1" 
                Background="#0F172A" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="CategoryText"
                               Foreground="#60A5FA"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="CaptionText"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                
                <Button Grid.Column="1"
                        Content="Close"
                        Click="CloseButton_Click"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="20,8"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
